{
  "schemaVersion": 1,
  "id": "seedance-flf2v",
  "name": "Seedance 2.0 首尾帧生视频",
  "description": "ByteDance Seedance 2.0 首尾帧插帧视频生成",
  "mediaType": "video",
  "graph": {
    "1": {
      "inputs": {
        "model": "Seedance 2.0",
        "model.prompt": "Cinematic transition between first and last frame",
        "model.resolution": "720p",
        "model.ratio": "16:9",
        "model.duration": 5,
        "model.generate_audio": true,
        "model.auto_downscale": true,
        "model.auto_upscale": false,
        "seed": 0,
        "watermark": false,
        "first_frame": [
          "3",
          0
        ],
        "last_frame": [
          "4",
          0
        ]
      },
      "class_type": "ByteDance2FirstLastFrameNode",
      "_meta": {
        "title": "Seedance 首尾帧生成"
      }
    },
    "2": {
      "inputs": {
        "filename_prefix": "video/Seedance_FLF2V",
        "format": "auto",
        "codec": "auto",
        "video": [
          "1",
          0
        ]
      },
      "class_type": "SaveVideo",
      "_meta": {
        "title": "保存视频"
      }
    },
    "3": {
      "inputs": {
        "image": "first_frame.png"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "加载首帧"
      }
    },
    "4": {
      "inputs": {
        "image": "last_frame.png"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "加载尾帧"
      }
    }
  }
}