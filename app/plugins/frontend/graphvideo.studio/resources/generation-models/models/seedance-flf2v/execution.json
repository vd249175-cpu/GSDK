{
  "schemaVersion": 2, "kind": "comfy-template", "workflow": "workflow.json", "outputKind": "video",
  "bindings": [
    { "source": "parameter", "name": "seedance_model", "nodeId": "1", "input": "model" },
    { "source": "prompt", "nodeId": "1", "input": "model.prompt" },
    { "source": "parameter", "name": "resolution", "nodeId": "1", "input": "model.resolution" },
    { "source": "parameter", "name": "aspect_ratio", "nodeId": "1", "input": "model.ratio" },
    { "source": "parameter", "name": "duration", "nodeId": "1", "input": "model.duration" },
    { "source": "parameter", "name": "generate_audio", "nodeId": "1", "input": "model.generate_audio" },
    { "source": "parameter", "name": "seed", "nodeId": "1", "input": "seed" },
    { "source": "parameter", "name": "watermark", "nodeId": "1", "input": "watermark" },
    { "source": "parameter", "name": "seedance_model", "nodeId": "2", "input": "filename_prefix", "transform": "spaceUnderscore", "prefix": "video/Seedance_FLF2V_" },
    { "source": "parameter", "name": "seedance_model", "nodeId": "1", "input": "model.output_format", "value": "mp4", "when": { "parameter": "seedance_model", "equals": "Seedance 2.5" } }
  ],
  "referenceSlots": [
    { "type": "image", "maximum": 2, "loaderClass": "LoadImage", "loaderInput": "image", "fixed": [
      { "nodeId": "3", "targetNodeId": "1", "targetInput": "first_frame" },
      { "nodeId": "4", "targetNodeId": "1", "targetInput": "last_frame" }
    ] }
  ]
}
