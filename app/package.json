{
  "name": "local-app",
  "version": "1.0.0",
  "private": true,
  "description": "本地应用：Electron 壳 + Vite/React renderer，纯源码直连微内核与 SDK",
  "type": "module",
  "main": "src-main/main.mjs",
  "scripts": {
    "dev": "vite --config renderer/vite.config.ts",
    "build:main": "esbuild ../plugins/graphvideo.studio/backend.ts --bundle --platform=node --format=esm --outfile=../plugins/graphvideo.studio/backend.js --alias:@graphvideo/sdk/protocol=../packages/sdk/javascript/src/protocol/index.ts --alias:@graphvideo/sdk/node=../packages/sdk/javascript/src/node/index.ts --alias:@graphvideo/sdk/plugin=../packages/sdk/javascript/src/plugin/index.ts --alias:@graphvideo/sdk/analysis=../packages/sdk/javascript/src/analysis/index.ts --alias:@graphvideo/sdk/effect=../packages/sdk/javascript/src/effect/index.ts --alias:@graphvideo/sdk/agent=../packages/sdk/javascript/src/agent/index.ts --alias:@graphvideo/sdk/testing=../packages/sdk/javascript/src/testing/index.ts --alias:yaml=./node_modules/yaml/browser/index.js --external:*.node --external:typescript && esbuild src-main/effects/node-generation-adapter.ts --bundle --platform=node --format=esm --packages=external --outfile=src-main/effects/node-generation-adapter.js",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "prestart": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "diagnose": "tsx scripts/diagnose.mjs",
    "demo:topology": "tsx scripts/demo-topology.mjs",
    "demo:op": "node scripts/demo-op.mjs",
    "check:renderer-boundary": "node scripts/check-renderer-boundary.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "build": "npm run build:main && vite build --config renderer/vite.config.ts && node --check src-main/main.mjs && node --check src-main/preload.cjs && node --check src-main/graph-host.mjs && node --check src-main/native-graph-host.mjs && node --check src-main/demo-controller.mjs && node --check scripts/demo-topology.mjs && node --check scripts/diagnose.mjs",
    "verify:native-load": "node ../packages/rust/scripts/verify-electron-native.mjs",
    "verify": "npm run check:renderer-boundary && npm run typecheck && npm run test && npm run diagnose -- validate && npm run verify:native-load && npm run build"
  },
  "dependencies": {
    "@graphvideo/client": "file:../packages/frontend/client",
    "@graphvideo/sdk": "file:../packages/sdk/javascript",
    "@graphvideo/tokens": "file:../packages/frontend/tokens",
    "@graphvideo/ui": "file:../packages/frontend/ui",
    "@graphvideo/workbench": "file:../packages/frontend/workbench",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^35.7.5",
    "tsx": "^4.23.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
