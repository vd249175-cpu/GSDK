{
  "id": "graphframework-demo",
  "name": "GraphFramework Demo",
  "version": "1.0.0",
  "defaultTheme": "dark",
  "defaultWorkspace": "default",
  "plugins": [
    { "id": "demo.topology", "path": "plugins/backend/demo-topology" },
    { "id": "demo.topology", "path": "plugins/frontend/demo-topology" }
  ],
  "desktop": {
    "host": { "pluginId": "demo.topology", "entry": "desktop/demo-controller.mjs" },
    "renderer": { "pluginId": "demo.topology", "entry": "frontend/app.tsx" }
  }
}
