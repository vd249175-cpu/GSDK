{
  "schemaVersion": 2,
  "id": "minimax-h3-video",
  "name": "MiniMax 海螺 H3 · 音画联合与多参考图视频生成",
  "description": "支持多参考图和音频联合输入的视频生成模型。",
  "mediaType": "video",
  "provider": "comfy",
  "parameters": {
    "duration": { "type": "integer", "minimum": 4, "maximum": 15 },
    "resolution": { "type": "string", "enum": ["768P", "2K"] },
    "aspectRatio": { "type": "string", "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"], "outputName": "aspect_ratio" },
    "enableLightningLora": { "type": "boolean", "outputName": "enable_lightning_lora" },
    "watermark": { "type": "boolean" },
    "seed": { "type": "integer", "minimum": 0 }
  },
  "defaults": { "duration": 5, "resolution": "768P", "aspectRatio": "16:9", "enableLightningLora": false, "watermark": false, "seed": 42 },
  "prompt": { "aliases": { "image": "<Picture {ordinal}>", "audio": "<Audio {ordinal}>" } },
  "dependencies": { "requireReady": true, "counts": { "image": { "maximum": 9 }, "audio": { "maximum": 3 } } },
  "budget": { "kind": "linear", "parameter": "duration", "rate": 2.86, "mode": "cloud_gpu" }
}
