node_modules/
# SDK dist bundles are local Electron-loadable build output (rebuild via build:dist)
packages/sdk/javascript/dist/
dist/
packages/desktop/dist/
.vite/
coverage/
*.tsbuildinfo
.DS_Store
*.log
.env
.env.local
credentials.json
credentials.local.json
credentials.*.json
*.credentials.json

# init 冷启动随包产物（export:sdk 组装，不进源码）
sdk/init-bundle/

# Rust 原生内核构建产物
/target/
packages/rust/target/
**/target/

# Staged native binding (rebuild via npm run build:native)
packages/rust/kernel-node/*.node

# Main process and plugin build artifacts
app/plugins/*/backend.js
app/plugins/*/desktop/**/*.js
packages/desktop/host/native-graph-host.js
packages/desktop/host/services/element-catalog.js
**/.pytest_cache/
**/__pycache__/
*.pyc
**/.test-temp/
**/.legacy-node-modules/
**/.legacy-renderer-dist/
**/.graphvideo-history.json
app/plugins/graphvideo.studio/resources/sample-media/
**/.legacy-resources/
**/.legacy-plugin-build/
**/.legacy-main-build/
**/.legacy-vitest-node-modules/
# Named runs: keep configs and sources, never credentials or generated output.
.generated/
runs/*/.generated/
runs/*/run.lock.json

# Agent browser runtime profiles and local authentication
.agents/browser/
.agents/.lark-auth/

# Playwright MCP run output (screenshots, page snapshots)
.playwright-mcp/

# Playwright CLI run output
.playwright-cli/
