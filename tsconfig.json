{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client", "node"],
    "useDefineForClassFields": true,
  "paths": {
      "@graphvideo/sdk/protocol": ["./packages/sdk/javascript/src/protocol/index.ts"],
      "@graphvideo/sdk/node": ["./packages/sdk/javascript/src/node/index.ts"],
      "@graphvideo/sdk/effect": ["./packages/sdk/javascript/src/effect/index.ts"],
      "@graphvideo/sdk/plugin": ["./packages/sdk/javascript/src/plugin/index.ts"],
      "@graphvideo/sdk/analysis": ["./packages/sdk/javascript/src/analysis/index.ts"],
      "@graphvideo/sdk/agent": ["./packages/sdk/javascript/src/agent/index.ts"],
      "@graphvideo/sdk/testing": ["./packages/sdk/javascript/src/testing/index.ts"],
      "@graphvideo/sdk/client": ["./packages/frontend/client/index.ts"],
      "@graphvideo/client-sdk": ["./apps/local-app/renderer/src/studio/client-sdk.ts"],
      "@graphvideo/sdk/tokens": ["./packages/frontend/tokens/index.ts"],
      "@graphvideo/sdk/ui": ["./packages/frontend/ui/index.ts"],
      "@graphvideo/sdk/workbench": ["./packages/frontend/workbench/src/index.ts"],
      "@graphvideo/sdk/workbench/*": ["./packages/frontend/workbench/src/*"],
      "@graphvideo/workbench": ["./packages/frontend/workbench/src/index.ts"],
      "@graphvideo/workbench/*": ["./packages/frontend/workbench/src/*"]
    }
  },
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/dist/**", "packages/sdk/javascript/tests/type-client.ts"],
  "include": ["sdk", "packages/frontend", "packages/sdk/javascript"]
}