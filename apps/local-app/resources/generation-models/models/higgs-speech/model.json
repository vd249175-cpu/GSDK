{
  "schemaVersion": 2,
  "id": "higgs-speech",
  "name": "Higgs 2.0 · 广播级多情感对白与配音",
  "description": "局域网 GPU 中台语音模型，支持戏剧对白、情感表演和声纹继承。",
  "mediaType": "audio",
  "provider": "audio",
  "parameters": {
    "emotion": { "type": "string", "enum": ["neutral", "happy", "sad", "angry", "fearful", "whisper", "elation", "amusement", "contemplation", "determination"] },
    "speed": { "type": "number", "minimum": 0.5, "maximum": 2 },
    "voiceReference": { "type": "string", "outputName": "voice_reference" },
    "temperature": { "type": "number", "minimum": 0.1, "maximum": 2 }
  },
  "defaults": { "emotion": "neutral", "speed": 1, "voiceReference": "", "temperature": 0.7 },
  "prompt": {
    "stripTypes": ["audio"],
    "stripAllReferences": true,
    "emotion": {
      "parameter": "emotion",
      "tags": {
        "angry": "<|emotion:anger|>", "happy": "<|emotion:elation|>", "elation": "<|emotion:elation|>",
        "sad": "<|emotion:sadness|>", "fearful": "<|emotion:fear|>", "whisper": "<|style:whispering|>",
        "amusement": "<|emotion:amusement|>", "contemplation": "<|emotion:contemplation|>", "determination": "<|emotion:determination|>"
      }
    }
  },
  "dependencies": { "counts": { "audio": { "maximum": 1 } }, "requiredReferenceOrParameter": [{ "type": "audio", "parameter": "voiceReference" }] },
  "budget": { "kind": "free", "mode": "lan_local", "currency": "free_lan" }
}
