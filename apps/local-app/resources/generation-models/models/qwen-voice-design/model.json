{
  "schemaVersion": 2,
  "id": "qwen-voice-design",
  "name": "Qwen3 · 声纹人设设计与音色定制",
  "description": "局域网 GPU 中台声纹引擎，支持文字设计和录音克隆。",
  "mediaType": "audio",
  "provider": "audio",
  "parameters": {
    "kind": { "type": "string", "enum": ["voiceprint"] },
    "transcript": { "type": "string" },
    "description": { "type": "string" },
    "gender": { "type": "string", "enum": ["male", "female", "child", "neutral"] },
    "age": { "type": "string", "enum": ["child", "teen", "young_adult", "middle_aged", "elderly"] },
    "accent": { "type": "string" },
    "voice_id": { "type": "string" },
    "name": { "type": "string" },
    "seed_text": { "type": "string" },
    "seed": { "type": "integer", "minimum": 0 }
  },
  "defaults": { "kind": "voiceprint", "gender": "female", "age": "young_adult", "accent": "standard", "seed": 0 },
  "prompt": { "stripTypes": ["image", "video", "audio", "style"] },
  "dependencies": { "counts": { "audio": { "maximum": 1 } }, "parameterRequiredWhenReferenced": [{ "type": "audio", "parameter": "transcript" }] },
  "budget": { "kind": "free", "mode": "lan_local", "currency": "free_lan" }
}
