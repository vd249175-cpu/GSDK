{
  "schemaVersion": 2,
  "id": "seedance-video",
  "name": "Seedance · 多模态视频生成工作流",
  "description": "Seedance 官方多模态视频工作流，支持图像、视频和音频参考。",
  "mediaType": "video",
  "provider": "comfy",
  "aliases": ["seedance-mini-video", "seedance-2.0", "seedance-2.5"],
  "aliasDefaults": {
    "seedance-mini-video": { "seedanceModel": "Seedance 2.0 Mini" },
    "seedance-2.0": { "seedanceModel": "Seedance 2.0" },
    "seedance-2.5": { "seedanceModel": "Seedance 2.5" }
  },
  "parameters": {
    "seedanceModel": { "type": "string", "enum": ["Seedance 2.0", "Seedance 2.0 Mini", "Seedance 2.0 Fast", "Seedance 2.5"], "outputName": "seedance_model" },
    "duration": { "type": "integer", "minimum": 4, "maximum": 30 },
    "resolution": { "type": "string", "enum": ["480p", "720p", "1080p", "4k"] },
    "aspectRatio": { "type": "string", "enum": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9", "adaptive"], "outputName": "aspect_ratio" },
    "generateAudio": { "type": "boolean", "outputName": "generate_audio" },
    "taskType": { "type": "string", "enum": ["auto", "reference", "edit", "extend"], "outputName": "task_type" },
    "watermark": { "type": "boolean" },
    "seed": { "type": "integer", "minimum": 0 }
  },
  "defaults": { "seedanceModel": "Seedance 2.0", "duration": 5, "resolution": "720p", "aspectRatio": "16:9", "generateAudio": true, "taskType": "reference", "watermark": false, "seed": 42 },
  "prompt": { "aliases": { "image": "Image_{ordinal}", "video": "Video_{ordinal}", "audio": "Audio_{ordinal}", "style": "Style_{ordinal}: {content}" } },
  "dependencies": { "requireReady": true, "counts": { "image": { "maximum": 9 }, "video": { "maximum": 3 }, "audio": { "maximum": 3 } }, "atLeastOneReferenceOf": [{ "types": ["image", "video", "audio"], "message": "Seedance Reference 工作流至少需要一个图片、视频或音频参考资产" }], "referenceDurationAtMostParameter": "duration", "parameterMaximums": { "duration": { "maximum": 15, "message": "Seedance 2.0 时长上限为 15 秒" } } },
  "variants": [
    { "when": { "parameter": "seedanceModel", "equals": "Seedance 2.0 Mini" }, "dependencies": { "requireReady": true, "counts": { "image": { "minimum": 1, "maximum": 2, "message": "Seedance 2.0 Mini 至少需要一个图片参考资产" }, "video": { "maximum": 0 }, "audio": { "maximum": 0 } }, "atLeastOneReferenceOf": [{ "types": ["image"], "message": "Seedance 2.0 Mini 至少需要一个图片参考资产" }], "referenceDurationAtMostParameter": "duration", "parameterMaximums": { "duration": { "maximum": 15, "message": "Seedance 2.0 Mini 时长上限为 15 秒" } } }, "budget": { "kind": "stepped", "parameter": "duration", "baseUnits": 5, "base": 110, "perUnit": 12, "multiplierParameter": "resolution", "multipliers": { "4k": 2.5, "1080p": 1.5 }, "defaultMultiplier": 1, "mode": "partner_stepped" } },
    { "when": { "parameter": "seedanceModel", "equals": "Seedance 2.5" }, "dependencies": { "requireReady": true, "counts": { "image": { "maximum": 20 }, "video": { "maximum": 6 }, "audio": { "maximum": 6 } }, "atLeastOneReferenceOf": [{ "types": ["image", "video", "audio"], "message": "Seedance Reference 工作流至少需要一个图片、视频或音频参考资产" }], "referenceDurationAtMostParameter": "duration", "parameterMaximums": {} }, "budget": { "kind": "stepped", "parameter": "duration", "baseUnits": 5, "base": 350, "perUnit": 35, "multiplierParameter": "resolution", "multipliers": { "4k": 2.5, "1080p": 1.5 }, "defaultMultiplier": 1, "mode": "partner_stepped" } }
  ],
  "budget": { "kind": "stepped", "parameter": "duration", "baseUnits": 5, "base": 319, "perUnit": 32, "multiplierParameter": "resolution", "multipliers": { "4k": 2.5, "1080p": 1.5 }, "defaultMultiplier": 1, "mode": "partner_stepped" }
}
