{
  "version": 2,
  "name": "demo",
  "plugins": {
    "backend": [
      {
        "id": "demo.topology",
        "path": "../../app/plugins/backend/demo-topology"
      }
    ],
    "frontend": []
  },
  "kernel": {
    "daemonPath": "../../packages/rust/target/debug/graphframework-kernel-daemon",
    "bind": "127.0.0.1:0",
    "startupTimeoutMs": 10000,
    "shutdownTimeoutMs": 10000
  },
  "backend": {
    "dependencies": {}
  },
  "frontend": {
    "instances": []
  },
  "graph": {
    "instances": [
      {
        "kind": "graph",
        "id": "topology",
        "factory": {
          "plugin": "demo.topology",
          "name": "createDemoTopologyGraph"
        }
      }
    ]
  },
  "lifecycle": {
    "initInfos": [],
    "startInfos": [
      {
        "targetNodeId": "topology/orders",
        "info": {
          "type": "SubmitOrder",
          "orderId": "order-1"
        }
      }
    ],
    "stopInfos": [],
    "ready": null,
    "timeouts": {
      "initMs": 30000,
      "startMs": 30000,
      "stopMs": 30000,
      "settleMs": 30000
    }
  },
  "scenarios": [
    {
      "name": "order-fulfillment",
      "inputs": [
        {
          "targetNodeId": "topology/orders",
          "info": {
            "type": "SubmitOrder",
            "orderId": "order-2"
          }
        }
      ],
      "assertions": [
        {
          "nodeId": "topology/orders",
          "state": {
            "placed": 2
          }
        },
        {
          "nodeId": "topology/ledger",
          "state": {
            "receipts": [
              "order-1",
              "order-2"
            ]
          }
        }
      ],
      "timeoutMs": 10000
    }
  ],
  "resources": {
    "generatedDirectory": ".generated",
    "dataDirectory": ".generated/data",
    "logsDirectory": ".generated/logs",
    "runtimeDirectory": ".generated/runtime"
  }
}
