{
  "version": 2,
  "name": "studio",
  "plugins": {
    "backend": [
      { "id": "graphvideo.studio", "path": "../../app/plugins/backend/graphvideo.studio" }
    ],
    "frontend": [
      { "id": "graphvideo.studio", "path": "../../app/plugins/frontend/graphvideo.studio" }
    ]
  },
  "kernel": {
    "daemonPath": "../../packages/rust/target/debug/graphvideo-kernel-daemon",
    "bind": "127.0.0.1:0",
    "startupTimeoutMs": 10000,
    "shutdownTimeoutMs": 10000
  },
  "backend": {
    "host": "backend/host.mjs",
    "dependencies": {}
  },
  "frontend": {
    "instances": [
      { "id": "studio-ui", "plugin": "graphvideo.studio", "graph": "studio", "entry": null }
    ]
  },
  "graph": {
    "instances": [
      { "kind": "graph", "id": "studio", "factory": { "plugin": "graphvideo.studio", "name": "createStudioNodes" } }
    ]
  },
  "lifecycle": {
    "initInfos": [],
    "startInfos": [
      { "targetNodeId": "studio/node-application-lifecycle", "info": { "type": "SystemStartRequestedInfo", "requestId": "studio-boot" } }
    ],
    "stopInfos": [
      { "targetNodeId": "studio/node-application-lifecycle", "info": { "type": "SystemShutdownRequestedInfo", "requestId": "studio-shutdown" }, "await": { "nodeId": "studio/node-application-lifecycle", "state": { "phase": "AwaitingDrain" } } },
      { "targetNodeId": "studio/node-application-lifecycle", "info": { "type": "SystemShutdownDrainObservedInfo", "requestId": "studio-shutdown" }, "await": { "nodeId": "studio/node-application-lifecycle", "state": { "phase": "ShutdownReady" } } }
    ],
    "ready": { "nodeId": "studio/node-application-lifecycle", "state": { "phase": "Ready" } },
    "timeouts": { "initMs": 30000, "startMs": 30000, "stopMs": 30000, "settleMs": 30000 }
  },
  "scenarios": null,
  "resources": {
    "generatedDirectory": ".generated",
    "dataDirectory": ".generated/data",
    "logsDirectory": ".generated/logs",
    "runtimeDirectory": ".generated/runtime"
  }
}
