{
  "name": "@graphvideo/sdk",
  "version": "1.0.3",
  "description": "GraphFramework developer SDK: backend, client, tokens, ui, testing, analysis, contract",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:vd249175-cpu/GSDK.git",
    "directory": "sdk"
  },
  "bin": {
    "graphvideo-init": "./bin/graphvideo-init.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./backend": {
      "types": "./backend/index.ts",
      "default": "./backend/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "default": "./client/index.ts"
    },
    "./workbench": {
      "types": "./workbench/src/index.ts",
      "default": "./workbench/src/index.ts"
    },
    "./workbench/styles.css": "./workbench/src/styles/index.css",
    "./tokens": {
      "types": "./tokens/index.ts",
      "default": "./tokens/index.ts"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "default": "./ui/index.ts"
    },
    "./ui/styles.css": "./ui/styles.css",
    "./testing": {
      "types": "./testing/index.ts",
      "default": "./testing/index.ts"
    },
    "./analysis": {
      "types": "./analysis/index.ts",
      "default": "./analysis/index.ts"
    },
    "./contract": {
      "types": "./contract/index.ts",
      "default": "./contract/index.ts"
    }
  },
  "peerDependencies": {
    "@graphvideo/kernel": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^1.30.0",
    "typescript": "^5.0.0"
  }
}
