{
  "name": "graphvideo-sdk-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "sdk",
    "sdk/backend",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:native": "cargo build -p graphvideo-kernel-node && node scripts/stage-native.mjs",
    "build:native:release": "cargo build --release -p graphvideo-kernel-node && node scripts/stage-native.mjs --release",
    "build:runtime": "vite build --config vite.backend.config.ts && node scripts/stage-backend-native.mjs",
    "benchmark:native": "node --expose-gc scripts/benchmark-native.mjs",
    "test": "vitest run --project core --project unit --project ui",
    "test:core": "vitest run --project core",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:app": "npm --prefix apps/local-app test",
    "verify:app": "npm run build:native && npm run build:runtime && npm --prefix apps/local-app run verify",
    "refactor": "node scripts/refactor.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.4.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
