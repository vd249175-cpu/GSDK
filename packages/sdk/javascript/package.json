{
  "name": "@graphframework/sdk",
  "version": "1.0.3",
  "description": "GraphFramework mirror SDK (JavaScript): protocol, node, effect, plugin, analysis, agent, testing",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:vd249175-cpu/GSDK.git",
    "directory": "packages/sdk/javascript"
  },
  "bin": {
    "graphframework-init": "./bin/graphframework-init.mjs"
  },
  "scripts": {
    "build:dist": "vite build --config vite.dist.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "exports": {
    "./protocol": {
      "types": "./src/protocol/index.ts",
      "graphframework-source": "./src/protocol/index.ts",
      "default": "./dist/protocol.js"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "graphframework-source": "./src/node/index.ts",
      "default": "./dist/node.js"
    },
    "./effect": {
      "types": "./src/effect/index.ts",
      "graphframework-source": "./src/effect/index.ts",
      "default": "./dist/effect.js"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "graphframework-source": "./src/plugin/index.ts",
      "default": "./dist/plugin.js"
    },
    "./analysis": {
      "types": "./src/analysis/index.ts",
      "graphframework-source": "./src/analysis/index.ts",
      "default": "./dist/analysis.js"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "graphframework-source": "./src/agent/index.ts",
      "default": "./dist/agent.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "graphframework-source": "./src/testing/index.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
