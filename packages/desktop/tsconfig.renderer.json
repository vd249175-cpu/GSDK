{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@graphvideo/sdk/protocol": [
        "../sdk/javascript/src/protocol/index.ts"
      ],
      "@graphvideo/workbench": [
        "../frontend/workbench/src/index.ts"
      ],
      "@graphvideo/workbench/*": [
        "../frontend/workbench/src/*"
      ],
      "@graphvideo/ui": [
        "../frontend/ui/index.ts"
      ],
      "@graphvideo/context": [
        "../frontend/context/index.ts"
      ],
      "@graphvideo/client": [
        "../frontend/client/index.ts"
      ],
      "react": [
        "node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ],
      "react-dom": ["node_modules/@types/react-dom/index.d.ts"],
      "@graphvideo/sdk/node": ["../sdk/javascript/src/node/index.ts"],
      "lucide-react": [
        "node_modules/lucide-react/dist/lucide-react.d.ts"
      ],
      "yaml": [
        "node_modules/yaml/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "../frontend/client/typecheck.ts",
    "renderer/src",
    "build/vite.config.ts",
    "../../app/plugins/*/frontend",
    "../../app/plugins/*/elements",
    "../../app/plugins/frontend/*/frontend",
    "../../app/plugins/frontend/*/elements"
  ],
  "exclude": [
    "../../app/plugins/**/*.test.ts",
    "../../app/plugins/**/*.test.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
