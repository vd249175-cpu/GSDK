{
  "name": "@graphvideo/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable GraphVideo desktop host, renderer and source build toolchain. Applications are plugin assemblies.",
  "type": "module",
  "main": "host/main.mjs",
  "scripts": {
    "dev": "vite --config build/vite.config.ts",
    "build:main": "node build/build-main.mjs",
    "build:renderer": "vite build --config build/vite.config.ts",
    "prestart": "npm run build",
    "start": "electron .",
    "diagnose": "node --conditions=graphvideo-source --import tsx ../../app/plugins/hello-counter/scripts/diagnose.mjs",
    "demo:topology": "node --conditions=graphvideo-source --import tsx ../../app/plugins/demo-topology/scripts/demo-topology.mjs",
    "demo:op": "node ../../app/plugins/demo-topology/scripts/demo-op.mjs",
    "check:renderer-boundary": "node scripts/check-renderer-boundary.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "build": "npm run build:main && npm run build:renderer && node --check host/main.mjs",
    "verify:native-load": "node ../rust/scripts/verify-electron-native.mjs",
    "verify": "npm run check:renderer-boundary && npm run typecheck && npm run test -- --silent && npm run diagnose -- validate && npm run verify:native-load && npm run build"
  },
  "dependencies": {
    "@graphvideo/client": "file:../frontend/client",
    "@graphvideo/sdk": "file:../sdk/javascript",
    "@graphvideo/ui": "file:../frontend/ui",
    "@graphvideo/workbench": "file:../frontend/workbench",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1",
    "@graphvideo/context": "file:../frontend/context",
    "@graphvideo/theme": "file:../frontend/theme"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^35.7.5",
    "tsx": "^4.23.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "esbuild": "^0.25.0"
  },
  "exports": {
    "./plugin-loader": "./host/plugin-loader.mjs",
    "./application": "./application.mjs",
    "./graph-host": "./host/native-graph-host.js",
    "./agent-control": "./host/services/agent-control.mjs",
    "./element-catalog": "./host/services/element-catalog.js",
    "./electron-window": "./host/effects/electron-window-adapter.mjs",
    "./renderer-security": "./host/services/renderer-security.mjs",
    "./window-options": "./host/services/window-options.mjs"
  }
}
