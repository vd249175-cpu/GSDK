{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@graphframework/sdk/protocol": [
        "../sdk/javascript/src/protocol/index.ts"
      ],
      "@graphframework/workbench": [
        "../frontend/workbench/src/index.ts"
      ],
      "@graphframework/workbench/*": [
        "../frontend/workbench/src/*"
      ],
      "@graphframework/ui": [
        "../frontend/ui/index.ts"
      ],
      "@graphframework/context": [
        "../frontend/context/index.ts"
      ],
      "@graphframework/client": [
        "../frontend/client/index.ts"
      ],
      "react": [
        "node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ],
      "lucide-react": [
        "node_modules/lucide-react/dist/lucide-react.d.ts"
      ],
      "yaml": [
        "node_modules/yaml/dist/index.d.ts"
      ],
      "@graphframework/sdk/node": [
        "../sdk/javascript/src/node/index.ts"
      ],
      "@graphframework/sdk/effect": [
        "../sdk/javascript/src/effect/index.ts"
      ],
      "@graphframework/sdk/plugin": [
        "../sdk/javascript/src/plugin/index.ts"
      ],
      "@graphframework/sdk/analysis": [
        "../sdk/javascript/src/analysis/index.ts"
      ],
      "@graphframework/sdk/agent": [
        "../sdk/javascript/src/agent/index.ts"
      ],
      "@graphframework/sdk/testing": [
        "../sdk/javascript/src/testing/index.ts"
      ],
      "@graphframework/desktop/graph-host": [
        "host/native-graph-host.mjs"
      ],
      "@graphframework/desktop/*": [
        "host/*"
      ]
    }
  },
  "include": [
    "host",
    "application.mjs",
    "build",
    "scripts",
    "../../app/plugins/*/backend.ts",
    "../../app/plugins/*/backend.mjs",
    "../../app/plugins/*/desktop",
    "../../app/plugins/backend/*/index.ts",
    "../../app/plugins/backend/*/backend",
    "../../app/plugins/frontend/*/desktop"
  ],
  "exclude": [
    "../../app/plugins/**/*.test.ts",
    "../../app/plugins/**/*.test.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
